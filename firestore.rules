rules_version = '2';

// Reglas de Firestore del proyecto `planillas-backups-986dd`.
// NO se despliegan solas: copialas/pegalas en Firebase -> Firestore -> Reglas -> Publicar.
// (Este archivo es solo la copia versionada de referencia.)
// Formateado en lineas cortas a proposito: las lineas largas se parten al copiar/pegar
// desde el chat y rompen los strings entre comillas. No volver a juntar en una sola linea.

service cloud.firestore {
  match /databases/{database}/documents {

    // Respaldos CIFRADOS (AES-GCM; id = SHA-256("usuario:codigo")).
    // get si, list/delete no; create/update exige los campos + tope ~900 KB.
    match /backups/{id} {
      allow get: if true;
      allow list: if false;
      allow delete: if false;
      allow create, update: if
        request.resource.data.keys().hasAll(['iv', 'salt', 'data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }

    // Padron EN CLARO (datos NO sensibles): nombre + linea + metricas + version.
    // Legible y LISTABLE para el conteo de la pantalla de admin.
    match /padron/{id} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly([
          'nombre', 'linea', 'updatedAt', 'version',
          'donaciones', 'gracias', 'exportaciones', 'difusionVista'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() < 200
        && request.resource.data.linea is string
        && request.resource.data.linea.size() < 200;
    }

    // Config GLOBAL (un unico doc `global`): donador on/off + difusion actual.
    // La leen todos al abrir; la escribe el admin (merge: campos parciales).
    match /config/{id} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly([
          'beggarActivo', 'difusionId', 'difusionTitulo',
          'difusionCuerpo', 'difusionCreatedAt', 'updatedAt'
        ])
        && (
          !('difusionTitulo' in request.resource.data)
          || (
            request.resource.data.difusionTitulo is string
            && request.resource.data.difusionTitulo.size() < 300
          )
        )
        && (
          !('difusionCuerpo' in request.resource.data)
          || (
            request.resource.data.difusionCuerpo is string
            && request.resource.data.difusionCuerpo.size() < 4000
          )
        );
    }

    // Difusion: historial de mensajes enviados (inmutable).
    match /difusion/{id} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['titulo', 'cuerpo', 'createdAt'])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() < 300
        && request.resource.data.cuerpo is string
        && request.resource.data.cuerpo.size() < 4000;
    }

    // Uso GLOBAL de Firebase (contador del dia, hora del Pacifico).
    match /uso/{id} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['reads', 'writes', 'updatedAt'])
        && request.resource.data.reads is number
        && request.resource.data.writes is number;
    }
  }
}
