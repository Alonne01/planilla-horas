rules_version = '2';

// Reglas de Firestore del proyecto `planillas-backups-986dd`.
// NO se despliegan solas: copialas/pegalas en Firebase -> Firestore -> Reglas -> Publicar.
// (Este archivo es solo la copia versionada de referencia.)
// Formateado en lineas cortas a proposito: las lineas largas se parten al copiar/pegar
// desde el chat y rompen los strings entre comillas. No volver a juntar en una sola linea.

service cloud.firestore {
  match /databases/{database}/documents {

    // El ADMIN se autentica con Firebase Auth (email/password).
    // PEGAR ACA el UID de la cuenta admin (Firebase -> Authentication -> Users -> copiar UID).
    // Las escrituras de control (config / difusion / campos admin de mensajes) exigen este UID.
    function esAdmin() {
      return request.auth != null
        && request.auth.uid == 'comWF8BlxMXEYPoEbzy27LkM2fp1';
    }

    // Respaldos CIFRADOS (AES-GCM; id = SHA-256("usuario:codigo")).
    // get si, list no; delete si (para migrar un respaldo cuando el usuario corrige su nombre;
    // el id requiere nombre+codigo, no es enumerable). create/update exige los campos + tope ~900 KB.
    match /backups/{id} {
      allow get: if true;
      allow list: if false;
      allow delete: if true;
      // Acepta el respaldo LEGADO (schema 1: blob unico) y el v2 (dos secciones cifradas
      // shared/salary). El update PARCIAL de la PC (solo 'shared'+'updatedAt') deja un doc
      // v2 valido, asi que entra por la segunda rama. La PC no tiene la clave de 'salary'.
      allow create, update: if
        (
          request.resource.data.keys().hasAll(['iv', 'salt', 'data', 'updatedAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000
        )
        || (
          request.resource.data.schema == 2
          && request.resource.data.keys().hasOnly([
            'schema', 'shared', 'salary', 'updatedAt', 'usuario', 'linea'
          ])
          && request.resource.data.shared.data is string
          && request.resource.data.shared.data.size() < 900000
          && request.resource.data.salary.data is string
          && request.resource.data.salary.data.size() < 200000
        );
    }

    // Emparejamiento EFIMERO PC <-> telefono (estilo WhatsApp Web). id = sid aleatorio.
    // El "sobre" va cifrado E2E (ECDH hacia la clave publica de la PC): quien lea el doc sin
    // la privada de la PC (solo en RAM) no obtiene nada. get si (la PC hace polling); list no;
    // delete si (limpieza tras el handshake). create/update: shape + tope chico.
    match /pairing/{sid} {
      allow get: if true;
      allow list: if false;
      allow delete: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly([
          'pub', 'iv', 'data', 'expiresAt', 'createdAt'
        ])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 20000;
    }

    // Padron EN CLARO (datos NO sensibles): nombre + linea + metricas + version.
    // Legible y LISTABLE para el conteo de la pantalla de admin. delete si (migracion de nombre).
    match /padron/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly([
          'nombre', 'linea', 'updatedAt', 'version',
          'donaciones', 'gracias', 'exportaciones', 'difusionVista'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() < 200
        && request.resource.data.linea is string
        && request.resource.data.linea.size() < 200;
    }

    // Netos estimados por usuario (dato sensible): lectura SOLO del admin; el usuario sube el suyo.
    // id = mismo hash(usuario:codigo) del backup/padron. create/update valida shape + tipos.
    match /netos/{id} {
      allow read: if esAdmin();
      allow delete: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['nombre', 'neto', 'proyectado', 'updatedAt'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() < 200
        && request.resource.data.neto is number
        && request.resource.data.proyectado is number
        && request.resource.data.updatedAt is number;
    }

    // Config GLOBAL (un unico doc `global`): donador on/off + difusion actual.
    // La leen todos al abrir; la escribe el admin (merge: campos parciales).
    match /config/{id} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if
        esAdmin()
        && request.resource.data.keys().hasOnly([
          'beggarActivo', 'difusionId', 'difusionTitulo',
          'difusionCuerpo', 'difusionCreatedAt', 'updatedAt'
        ])
        && (
          !('difusionTitulo' in request.resource.data)
          || (
            request.resource.data.difusionTitulo is string
            && request.resource.data.difusionTitulo.size() < 300
          )
        )
        && (
          !('difusionCuerpo' in request.resource.data)
          || (
            request.resource.data.difusionCuerpo is string
            && request.resource.data.difusionCuerpo.size() < 4000
          )
        );
    }

    // Difusion: historial de mensajes enviados (inmutable).
    match /difusion/{id} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if
        esAdmin()
        && request.resource.data.keys().hasOnly(['titulo', 'cuerpo', 'createdAt'])
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() < 300
        && request.resource.data.cuerpo is string
        && request.resource.data.cuerpo.size() < 4000;
    }

    // Doc por-usuario (admin <-> un usuario). id = hash(usuario:codigo) del destinatario.
    // Lleva el mensaje individual (titulo/cuerpo/recibidoAt), el flag `beggar` (donador por-usuario) y
    // `salaryUnlock` (proyección salarial habilitada por el admin).
    // get si (el usuario lee el suyo / el admin lo lee por el id del padron). list no.
    match /mensajes/{id} {
      // Validacion de shape/tamano (sobre el doc resultante del merge).
      function tiposOk() {
        return request.resource.data.keys().hasOnly([
            'id', 'titulo', 'cuerpo', 'createdAt', 'recibidoAt',
            'beggar', 'salaryUnlock', 'salaryDeviceId', 'salaryConflict'
          ])
          && (!('titulo' in request.resource.data)
            || (request.resource.data.titulo is string && request.resource.data.titulo.size() < 300))
          && (!('cuerpo' in request.resource.data)
            || (request.resource.data.cuerpo is string && request.resource.data.cuerpo.size() < 4000))
          && (!('beggar' in request.resource.data)
            || request.resource.data.beggar is bool)
          && (!('salaryUnlock' in request.resource.data)
            || request.resource.data.salaryUnlock is bool)
          && (!('salaryDeviceId' in request.resource.data)
            || (request.resource.data.salaryDeviceId is string && request.resource.data.salaryDeviceId.size() < 200))
          && (!('salaryConflict' in request.resource.data)
            || request.resource.data.salaryConflict is bool);
      }

      allow get: if true;
      allow list, delete: if false;

      // UPDATE: el admin puede tocar todo; el usuario solo recibidoAt / salaryDeviceId / salaryConflict
      // (y salaryUnlock solo puede quedar igual o ir a false = revocar; nunca prenderlo).
      allow update: if tiposOk() && (
        esAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['recibidoAt', 'salaryDeviceId', 'salaryConflict', 'salaryUnlock'])
          && (
            !('salaryUnlock' in request.resource.data)
            || request.resource.data.salaryUnlock == false
            || request.resource.data.salaryUnlock == resource.data.salaryUnlock
          )
        )
      );

      // CREATE: el admin crea el mensaje/alta; el usuario solo puede crear con sus campos, sin nacer con
      // salaryUnlock ni beggar prendidos.
      allow create: if tiposOk() && (
        esAdmin()
        || (
          (!('salaryUnlock' in request.resource.data) || request.resource.data.salaryUnlock == false)
          && (!('beggar' in request.resource.data) || request.resource.data.beggar == false)
        )
      );
    }

    // Sugerencias (usuario -> admin). id = timestamp. Texto libre EN CLARO.
    // read si (el admin las lista); create si (con validacion de campos + tamano); update/delete no (inmutable).
    // El tope 1/dia por dispositivo es client-side (localStorage), como el resto de los topes de nube.
    match /sugerencias/{id} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['nombre', 'texto', 'version', 'createdAt', 'linea'])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() < 2000
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() < 200
        && request.resource.data.createdAt is number;
    }

    // Codigos RESERVADOS (segundo candado: codigos unicos entre usuarios). id = hash("planilla-codigo:"+codigo).
    // get si (verificar disponibilidad); create si (reservar); update/delete no (inmutable: nadie pisa el de otro).
    match /codigos/{id} {
      allow get: if true;
      allow list, update, delete: if false;
      allow create: if
        request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt is number;
    }

    // Uso GLOBAL de Firebase (contador del dia, hora del Pacifico).
    match /uso/{id} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if
        request.resource.data.keys().hasOnly(['reads', 'writes', 'updatedAt'])
        && request.resource.data.reads is number
        && request.resource.data.writes is number;
    }
  }
}
